      "collapsed": false,
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Running Cinema Containers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(count by (name) (container_cpu_usage_seconds_total{name=~\"cinema-.*\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 2,
      "title": "Container CPU Usage (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"cinema-.*\"}[1m])) by (name) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 3,
      "title": "Container Memory Usage (MB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{name=~\"cinema-.*\"}) by (name) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "title": "Container Network IO (KB/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\"cinema-.*\"}[1m])) by (name) / 1024",
          "legendFormat": "Rx: {{name}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{name=~\"cinema-.*\"}[1m])) by (name) / 1024",
          "legendFormat": "Tx: {{name}}",
          "refId": "B"
        }
      ]
    }
  ],
